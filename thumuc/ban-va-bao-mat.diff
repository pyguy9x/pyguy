+drop policy if exists "p2b_tt_btv_tasks_sel" on public.tt_btv_tasks;
+drop policy if exists "p2b_tt_btv_tasks_ins" on public.tt_btv_tasks;
+drop policy if exists "p2b_tt_btv_tasks_upd" on public.tt_btv_tasks;
+drop policy if exists "p2b_tt_btv_tasks_del" on public.tt_btv_tasks;
+create policy "p2a_tt_btv_tasks_all" on public.tt_btv_tasks for all to anon, authenticated using ((select public.vp_scope()) is not null) with check ((select public.vp_scope()) is not null);
+drop policy if exists "p2b_province_tasks_sel" on public.province_tasks;
+drop policy if exists "p2b_province_tasks_ins" on public.province_tasks;
+drop policy if exists "p2b_province_tasks_upd" on public.province_tasks;
+drop policy if exists "p2b_province_tasks_del" on public.province_tasks;
+create policy "p2a_province_tasks_all" on public.province_tasks for all to anon, authenticated using ((select public.vp_scope()) is not null) with check ((select public.vp_scope()) is not null);
