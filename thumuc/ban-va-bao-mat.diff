+drop policy if exists "p2b_action_100_days_tasks_ins" on public.action_100_days_tasks;
+drop policy if exists "p2b_action_100_days_tasks_upd" on public.action_100_days_tasks;
+drop policy if exists "p2b_action_100_days_tasks_del" on public.action_100_days_tasks;
+create policy "p2a_action_100_days_tasks_all" on public.action_100_days_tasks for all to anon, authenticated using ((select public.vp_scope()) is not null) with check ((select public.vp_scope()) is not null);
+drop policy if exists "p2b_vpub_tasks_sel" on public.vpub_tasks;
+drop policy if exists "p2b_vpub_tasks_ins" on public.vpub_tasks;
